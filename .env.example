APP_NAME="Progress New Model"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=progress_new_model_dev
DB_USERNAME=progress_dev
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=private
MAIL_MAILER=log
BCRYPT_ROUNDS=12
PROTOTYPE_ENABLED=false
PROTOTYPE_STORAGE=session
VITE_APP_NAME="${APP_NAME}"
AUTH_AUTO_LOGIN=false
